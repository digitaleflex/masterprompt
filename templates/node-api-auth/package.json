{
  "name": "node-api-auth-template",
  "version": "1.0.0",
  "description": "Template d'API Node.js avec authentification et sécurité",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "security:check": "npm audit",
    "security:auth": "node scripts/check-auth-security.js",
    "security:deps": "npx npm-check-updates -u && npm install"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.0",
    "joi": "^17.9.2",
    "dotenv": "^16.0.3",
    "express-rate-limit": "^6.7.0",
    "express-mongo-sanitize": "^2.2.0",
    "xss-clean": "^0.1.1",
    "helmet-csp": "^3.4.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.0",
    "jest": "^29.5.0",
    "supertest": "^6.3.3",
    "eslint": "^8.39.0",
    "prettier": "^2.8.8",
    "husky": "^8.0.0",
    "lint-staged": "^13.2.2"
  },
  "lint-staged": {
    "*.{js,json,md}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}