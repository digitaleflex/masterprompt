{
  "name": "masterprompt-cli",
  "version": "1.0.0",
  "description": "Interface en ligne de commande pour le framework MasterPrompt",
  "main": "index.js",
  "bin": {
    "masterprompt": "./bin/masterprompt"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "build": "babel src -d dist",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
