    "inquirer": "^8.0.0",
    "chalk": "^4.0.0",
    "fs-extra": "^10.0.0",
    "ora": "^5.0.0",
    "axios": "^1.0.0",
    "shelljs": "^0.8.5",
    "glob": "^8.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.0.0",
    "@babel/core": "^7.0.0",
    "@babel/preset-env": "^7.0.0",
    "eslint": "^8.0.0",
    "jest": "^28.0.0",
    "prettier": "^2.0.0"
  },
  "engines": {
    "node": ">=14.0.0"
  },
